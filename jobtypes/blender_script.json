   "required": true
  },
  "args": {
   "default": [],
   "help": "list passed after --"
  },
  "threads": 8
 },
 "cmd": [
  "{blender}",
  "-b",
  "--threads",
  "{threads}",
  "--python",
  "{script}",
  "--",
  "{*args}"
 ],
 "icon": "🛠️",
 "color": "#e87d0d",
 "he_title": "עבודת Blender",
 "he_desc": "מריץ סקריפט בתוכנת Blender",
