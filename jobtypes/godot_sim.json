{
 "id": "godot_sim",
 "title": "Godot logic test (headless, no GPU) via tools/run_game.py",
 "group": "Game",
 "klass": "cpu",
 "model": "godot",
 "est": {
  "ram_gb": 2,
  "vram_gb": 0,
  "commit_gb": 3
 },
 "max_parallel": 2,
 "params": {
  "scenario": {
   "required": true
  },
  "secs": 60
 },
 "cwd": "{game}",
 "cmd": [
  "{py_sys}",
  "{game}/tools/run_game.py",
  "sim",
  "{scenario}",
  "{secs}"
 ]
}